# 扫描工具生成的路径清单（含用户电脑隐私路径，不入库）
config/stignore-paths.json

# 替换工具产生的原文件备份
*.bak.*
config/*.bak.*

# 用户偏好配置（语言/主题，本地持久化，不入库）
config.json
*.mjs
_cnt.ps1

# Flutter pub get 日志（构建临时产物）
_pubget.log

# 本地临时脚本与校验产物（本机一次性文件，勿入库）
__*_tmp.ps1
_*.ps1
sdk_msi_codes.txt

# --- 编程工具配置目录：放行（保持跟踪，不忽略） ---
# .codebuddy/ .github/ .vscode/ .cursor/ .claude/ .idea/ 等工具配置目录
# 刻意不忽略，保留入库（含共享规则、AI 记忆、工作区设置等）。

# --- Coding 临时产生的文件与目录 ---
# 日志
*.log
*.log.*

# 编辑器/系统临时文件
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Flutter/Dart 构建缓存与生成物
app/.dart_tool/
app/build/
app/.flutter-plugins-dependencies
app/coverage/
