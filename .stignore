//Syncthing Ignore Patterns Lists
//Version: 1.15.0
//Updated: 2026-08-31

//System & OS Files
**/$RECYCLE.BIN/
**/#Recycle/
**/@Recycle/
**/.Recovery/
**/.Recycle_bin/
**/.Trash-*/
**/LOST.DIR/
**/System Volume Information/
**/found.000/
/Program Files/
/Program Files (x86)/
**/.@__thumb/
**/.@datasync_temp_*/
**/.AppleDB
**/.DS_Store
**/.VolumeIcon.icns
**/.PKInstallSandboxManager
**/.com.apple.timemachine.donotpresent
**/.metadata_never_index
**/Thumbs.db
**/ehthumbs.db
**/desktop.ini
**/pagefile.sys
**/swapfile.sys
**/hiberfil.sys
**/~$*

//Database Files
**/#innodb_redo/
**/#innodb_temp/
**/ibdata1
**/ib_logfile*
**/ibtmp1
**/mysql.sock
**/postmaster.pid
**/.pgpass
**/pg_wal/
**/pg_xlog/
**/sqlite.db
**/master.db
**/mongod.lock
**/WiredTiger*
**/journal/
**/dump.rdb
**/redis/
**/elastic/
**/data/elasticsearch/
**/leveldb/
**/rocksdb/
**/*.ibd
**/*.sqlite
**/*.sqlite3
**/*.db-wal
**/*.db-shm
**/*.db-journal
// NOTE: generic "**/*.db" is intentionally omitted — it would drop real
// SQLite/KeePass data files. Use the patterns below if you really need it:
// **/*.db

//Backup & Temporary Files
**/.delete/
**/.deletedByTMM/
**/.tmp/
**/Temp/
**/Backup_of_*
**/*.tmp
**/*.bak
**/*.old
**/*.orig
**/*.rej
**/.stignore.bak.*
**/stignore-paths.json.bak.*

//Application Data & Caches
// NOTE: .stfolder (folder marker) and .stversions (Syncthing versioning) are
// NOT ignored here — ignoring them breaks folder-marker detection on remotes
// and silently disables file versioning. Add them manually only if you are
// certain you never use Syncthing versioning.
**/.baiduyun.uploading.cfg
**/.dropbox.cache/
**/.egstore/
**/.gs/
**/.gs_*/
**/.hls/
**/.ldb/
**/.microthumbnailFile/
**/.midownloading/
**/.resona/
**/.secretAlbum/
**/.streams/
**/.stignore-extra
**/.sync/
**/.tmfs/
**/.trashBin/
**/.webaxs/
**/AliWorkbenchData/
**/BaiduNetdiskDownload/
**/KwDownload/
**/QLDownload/
**/SteamLibrary/
**/Tencent Files/
**/UpdateCache/
**/WeChat Files/
**/Youku Files/
**/debug_log/
**/hls/
**/nplayerdisk/
**/qycache/
**/sync.ffs_db
**/xiaoya/media/
**/config/index-v1/**
**/config/index-v2/**

//Version Control Systems
// NOTE: ignoring .git means repository history is not synced — remove this
// line if you intend to mirror working git repositories.
**/.git/
**/.svn/
**/.hg/

